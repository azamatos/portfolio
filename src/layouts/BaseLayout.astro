---
import { Font } from "astro:assets";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import ogImage from "@/assets/og-image.png";
import { THEME_COLOR, themeInitScript } from "@/lib/theme";
import { SITE } from "@/site";
import "@/styles/global.css";

interface Props {
  title?: string;
  description?: string;
  /** Keeps the page out of search results (the 404 page). */
  noindex?: boolean;
  /** A project page: turns on that project's accent tokens (--acc, --acc2, --on-acc) inside <main>. */
  project?: string;
}

const {
  title = SITE.title,
  description = SITE.description,
  noindex = false,
  project,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
// Imported, so the file name carries a content hash and link previews refetch it after every change.
const ogImageUrl = new URL(ogImage.src, Astro.site).href;

const person = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: SITE.name,
  url: SITE.url,
  jobTitle: SITE.role,
  email: `mailto:${SITE.email}`,
  knowsAbout: [
    "React",
    "TypeScript",
    "Node.js",
    "NestJS",
    "Next.js",
    "PostgreSQL",
  ],
  alumniOf: {
    "@type": "CollegeOrUniversity",
    name: "Belarus State Aviation Academy",
  },
  sameAs: [SITE.links.github, SITE.links.linkedin],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={SITE.name} />
    {noindex ? (
      <meta name="robots" content="noindex" />
    ) : (
      <link rel="canonical" href={canonical} />
    )}
    <!-- One colour per scheme; the script below and setTheme() point both at the picked theme. -->
    <meta
      name="theme-color"
      content={THEME_COLOR.dark}
      media="(prefers-color-scheme: dark)"
      data-scheme="dark"
    />
    <meta
      name="theme-color"
      content={THEME_COLOR.light}
      media="(prefers-color-scheme: light)"
      data-scheme="light"
    />
    <meta name="color-scheme" content="dark light" />
    <!-- Before first paint: apply the theme the visitor picked, so there is no flash. -->
    <script is:inline set:html={themeInitScript} />
    <!-- Controls that only work with JavaScript (the theme switch) stay out of the page without it. -->
    <noscript>
      <style is:inline>
        [data-js-only] {
          display: none !important;
        }
      </style>
    </noscript>

    <!-- Open Graph (LinkedIn / Telegram / Discord) -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={SITE.shareDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="azamatos" />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content={String(ogImage.width)} />
    <meta property="og:image:height" content={String(ogImage.height)} />
    <meta property="og:image:alt" content={`${SITE.name}, ${SITE.role}`} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={SITE.shareDescription} />
    <meta name="twitter:image" content={ogImageUrl} />

    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="azamatos" />
    <link rel="manifest" href="/site.webmanifest" />

    <Font cssVariable="--font-geist" preload />
    <Font cssVariable="--font-space-mono" preload />

    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(person)}
    />
  </head>

  <body>
    <div class="page">
      <Header />
      <main id="main" data-project={project}>
        <slot />
      </main>
      <Footer />
    </div>
    <!-- The ⌘K command palette goes here (phase 8). -->
  </body>
</html>

<style>
  .page {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
    min-height: 100dvh;
  }

  main {
    display: flex;
    flex: 1;
    flex-direction: column;
  }
</style>
