---
import { Font } from "astro:assets";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import CommandPalette from "@/components/CommandPalette.astro";
import ogImage from "@/assets/og-image.png";
import { THEME_COLOR, themeInitScript } from "@/lib/theme";
import { SITE } from "@/site";
import "@/styles/global.css";

/** A link preview's image: an absolute URL, its size and what it shows. */
export type ShareImage = {
  url: string;
  width: number;
  height: number;
  alt: string;
};

interface Props {
  title?: string;
  description?: string;
  /** The link preview's description: `description` when that's given, else the site's short one. */
  shareDescription?: string;
  /** The link preview's image; the site's og-image.png by default. */
  image?: ShareImage;
  /** og:type: "article" for a project page. */
  type?: "website" | "article";
  /** The page's path or URL for rel=canonical and og:url; the current path by default. */
  canonical?: string;
  /** Keeps the page out of search results (the 404 page). */
  noindex?: boolean;
  /** Origins the page loads its first images from, connected to early (media.azamatos.com on project pages). */
  preconnect?: string[];
  /** The id of the heading that names <main> (a project page's h1). */
  labelledby?: string;
  /** A project page: turns on that project's accent tokens (--acc, --acc2, --on-acc) inside <main>. */
  project?: string;
  /** More schema.org data about the page, after the Person. */
  jsonLd?: Record<string, unknown>;
}

const {
  title = SITE.title,
  description,
  shareDescription = description ?? SITE.shareDescription,
  image,
  type = "website",
  noindex = false,
  preconnect = [],
  labelledby,
  project,
  jsonLd,
} = Astro.props;

const canonical = new URL(
  Astro.props.canonical ?? Astro.url.pathname,
  Astro.site,
).href;
// Imported, so the file name carries a content hash and link previews refetch it after every change.
const share: ShareImage = image ?? {
  url: new URL(ogImage.src, Astro.site).href,
  width: ogImage.width,
  height: ogImage.height,
  alt: `${SITE.name}, ${SITE.role}`,
};

const person = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: SITE.name,
  url: SITE.url,
  jobTitle: SITE.role,
  email: `mailto:${SITE.email}`,
  knowsAbout: [
    "React",
    "TypeScript",
    "Node.js",
    "NestJS",
    "Next.js",
    "PostgreSQL",
  ],
  alumniOf: {
    "@type": "CollegeOrUniversity",
    name: "Belarus State Aviation Academy",
  },
  sameAs: [SITE.links.github, SITE.links.linkedin],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {preconnect.map((origin) => (
      <link rel="preconnect" href={origin} />
    ))}

    <title>{title}</title>
    <meta name="description" content={description ?? SITE.description} />
    <meta name="author" content={SITE.name} />
    {noindex ? (
      <meta name="robots" content="noindex" />
    ) : (
      <link rel="canonical" href={canonical} />
    )}
    <!-- One colour per scheme; the script below and setTheme() point both at the picked theme. -->
    <meta
      name="theme-color"
      content={THEME_COLOR.dark}
      media="(prefers-color-scheme: dark)"
      data-scheme="dark"
    />
    <meta
      name="theme-color"
      content={THEME_COLOR.light}
      media="(prefers-color-scheme: light)"
      data-scheme="light"
    />
    <meta name="color-scheme" content="dark light" />
    <!-- Before first paint: apply the theme the visitor picked, so there is no flash. -->
    <script is:inline set:html={themeInitScript} />
    <!-- Controls that only work with JavaScript (the theme switch) stay out of the page without it. -->
    <noscript>
      <style is:inline>
        [data-js-only] {
          display: none !important;
        }
      </style>
    </noscript>

    <!-- Open Graph (LinkedIn / Telegram / Discord) -->
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={shareDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="azamatos" />
    <meta property="og:image" content={share.url} />
    <meta property="og:image:width" content={String(share.width)} />
    <meta property="og:image:height" content={String(share.height)} />
    <meta property="og:image:alt" content={share.alt} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={shareDescription} />
    <meta name="twitter:image" content={share.url} />
    {image && <meta name="twitter:image:alt" content={share.alt} />}

    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="azamatos" />
    <link rel="manifest" href="/site.webmanifest" />

    <Font cssVariable="--font-geist" preload />
    <Font cssVariable="--font-space-mono" preload />

    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(person)}
    />
    {jsonLd && (
      <script
        is:inline
        type="application/ld+json"
        set:html={JSON.stringify(jsonLd)}
      />
    )}
  </head>

  <body>
    <div class="page">
      <Header />
      <main id="main" data-project={project} aria-labelledby={labelledby}>
        <slot />
      </main>
      <Footer />
    </div>
    <CommandPalette />
  </body>
</html>

<style>
  .page {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
    min-height: 100dvh;
  }

  main {
    display: flex;
    flex: 1;
    flex-direction: column;
  }
</style>
