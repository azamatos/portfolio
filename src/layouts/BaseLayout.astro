---
import { Font } from "astro:assets";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import CommandPalette from "@/components/CommandPalette.astro";
import heroPhoto from "@/assets/hero-photo.webp";
import { accentStyle, getProjects, type Project } from "@/lib/projects";
import { collectedSiteSchema } from "@/lib/projects/schema";
import { imageType, PERSON_ID, type ShareImage } from "@/lib/projects/share";
import { THEME_COLOR, themeInitScript } from "@/lib/theme";
import { SITE } from "@/site";
import "@/styles/global.css";

interface Props {
  title?: string;
  description?: string;
  /** The link preview's description: `description` when that's given, else the site's short one. */
  shareDescription?: string;
  /** The link preview's image; the site's card by default. */
  image?: ShareImage;
  /** og:type: "article" for a project page. */
  type?: "website" | "article";
  /** The page's path or URL for rel=canonical and og:url; the current path by default. */
  canonical?: string;
  /** Keeps the page out of search results (the 404 page). */
  noindex?: boolean;
  /** Origins the page loads its first images from, connected to early (media.azamatos.com on project pages). */
  preconnect?: string[];
  /** The id of the heading that names <main> (a project page's h1). */
  labelledby?: string;
  /** A project page: its colours (--acc, --acc2, --on-acc) inside <main>. */
  project?: Pick<Project, "id" | "accent">;
  /** More schema.org nodes about the page, in one @graph after the Person (no @context). */
  jsonLd?: Record<string, unknown>[];
}

const {
  title = SITE.title,
  description,
  shareDescription = description ?? SITE.shareDescription,
  image,
  type = "website",
  noindex = false,
  preconnect = [],
  labelledby,
  project,
  jsonLd = [],
} = Astro.props;

const home = `${SITE.url}/`;
const canonical = new URL(
  Astro.props.canonical ?? Astro.url.pathname,
  Astro.site,
).href;

// The site's card (the projects in a terminal), which the refresh command makes: src/data/collected/_site.json.
const siteFile = Object.values(
  import.meta.glob<unknown>("/src/data/collected/_site.json", {
    eager: true,
    import: "default",
  }),
)[0];
if (siteFile === undefined)
  throw new Error(
    "src/data/collected/_site.json is missing: run `pnpm data:refresh` for the site's share card.",
  );
const siteOg = collectedSiteSchema.parse(siteFile).og;
const names = new Intl.ListFormat("en").format(
  (await getProjects()).map((p) => p.name),
);
const share: ShareImage = image ?? {
  url: siteOg.url,
  width: siteOg.width,
  height: siteOg.height,
  type: imageType(siteOg.url),
  alt: `${SITE.name}, ${SITE.role}. A terminal lists his projects: ${names}.`,
};

const person = {
  "@type": "Person",
  "@id": PERSON_ID,
  name: SITE.name,
  url: home,
  image: new URL(heroPhoto.src, Astro.site).href,
  jobTitle: SITE.role,
  email: `mailto:${SITE.email}`,
  knowsAbout: [
    "React",
    "TypeScript",
    "Node.js",
    "NestJS",
    "Next.js",
    "PostgreSQL",
  ],
  alumniOf: {
    "@type": "CollegeOrUniversity",
    name: "Belarus State Aviation Academy",
  },
  sameAs: [SITE.links.github, SITE.links.linkedin],
};
// The home page names the site, for the name search results show above it.
const website = {
  "@type": "WebSite",
  "@id": `${home}#website`,
  name: SITE.name,
  alternateName: "azamatos",
  url: home,
  author: { "@id": PERSON_ID },
};
const graph = {
  "@context": "https://schema.org",
  "@graph": [person, ...(canonical === home ? [website] : []), ...jsonLd],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {preconnect.map((origin) => (
      <link rel="preconnect" href={origin} />
    ))}

    <title>{title}</title>
    <meta name="description" content={description ?? SITE.description} />
    <meta name="author" content={SITE.name} />
    {noindex ? (
      <meta name="robots" content="noindex" />
    ) : (
      <link rel="canonical" href={canonical} />
    )}
    <!-- One colour per scheme; the script below and setTheme() point both at the picked theme. -->
    <meta
      name="theme-color"
      content={THEME_COLOR.dark}
      media="(prefers-color-scheme: dark)"
      data-scheme="dark"
    />
    <meta
      name="theme-color"
      content={THEME_COLOR.light}
      media="(prefers-color-scheme: light)"
      data-scheme="light"
    />
    <meta name="color-scheme" content="dark light" />
    <!-- Before first paint: apply the theme the visitor picked, so there is no flash. -->
    <script is:inline set:html={themeInitScript} />
    <!-- Controls that only work with JavaScript (the theme switch) stay out of the page without it. -->
    <noscript>
      <style is:inline>
        [data-js-only] {
          display: none !important;
        }
      </style>
    </noscript>

    <!-- Open Graph (LinkedIn / Telegram / Discord / Slack); og:url is the canonical URL, so a noindex page has none -->
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={shareDescription} />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={share.url} />
    <meta property="og:image:type" content={share.type} />
    <meta property="og:image:width" content={String(share.width)} />
    <meta property="og:image:height" content={String(share.height)} />
    <meta property="og:image:alt" content={share.alt} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={shareDescription} />
    <meta name="twitter:image" content={share.url} />
    <meta name="twitter:image:alt" content={share.alt} />

    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-96x96.png" type="image/png" sizes="96x96" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="azamatos" />
    <link rel="manifest" href="/site.webmanifest" />

    <Font cssVariable="--font-geist" preload />
    <Font cssVariable="--font-space-mono" preload />

    <!-- "<" escaped, so no text in the data can close the script. -->
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(graph).replace(/</g, "\\u003c")}
    />
  </head>

  <body>
    <div class="page">
      <Header />
      <main
        id="main"
        data-project={project?.id}
        style={project && accentStyle(project.accent)}
        aria-labelledby={labelledby}
      >
        <slot />
      </main>
      <Footer />
    </div>
    <CommandPalette />
  </body>
</html>

<style>
  .page {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
    min-height: 100dvh;
  }

  main {
    display: flex;
    flex: 1;
    flex-direction: column;
  }
</style>
