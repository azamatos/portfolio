---
import EmailButton from "@/components/EmailButton.astro";
import { SITE } from "@/site";

interface Props {
  /** On a phone, adds `mail hi@azamatos.com` with its copy button under Download (the header hides it there). */
  mail?: boolean;
}

const { mail = false } = Astro.props;
---

<div class="resume">
  <div class="actions">
    <a class="download" href={SITE.resume.url} download>
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <g class="arrow">
          <path d="M12 4v11"></path>
          <path d="M7 10.5l5 5 5-5"></path>
        </g>
        <path d="M5 20h14"></path>
      </svg>
      Download resume
    </a>
    <a
      class="view only-desk"
      href={SITE.resume.url}
      target="_blank"
      rel="noopener"
    >
      View online
      <span class="sr-only">(opens in a new tab)</span>
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <g class="arrow">
          <path d="M7 17L17 7"></path>
          <path d="M8 7h9v9"></path>
        </g>
      </svg>
    </a>
    {mail && <EmailButton variant="line" class="only-phone" />}
  </div>
  <p class="meta only-desk">PDF · {SITE.resume.pages} pages</p>
</div>

<style>
  .resume {
    margin-top: 12px;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
  }

  a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    height: 48px;
    padding: 0 20px;
    border: 1px solid transparent;
    border-radius: 10px;
    font-size: 16px;
    font-weight: 500;
    letter-spacing: -0.02em;
    white-space: nowrap;
    transition:
      background 0.18s ease,
      border-color 0.18s ease,
      transform 0.12s ease;
  }

  a:active {
    transform: scale(0.98);
  }

  .download {
    background: var(--btn-bg);
    color: var(--btn-fg);
  }

  .download:hover {
    background: var(--btn-hover);
  }

  .view {
    border-color: var(--line);
    background: var(--chip);
    color: var(--fg);
  }

  .view:hover {
    background: var(--sel);
    border-color: var(--fg2);
  }

  svg {
    width: 18px;
    height: 18px;
    flex: none;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* The arrow glides in its direction on hover and keyboard focus, then eases back. */
  .arrow {
    transition: transform 0.4s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .download:is(:hover, :focus-visible) .arrow {
    transform: translateY(3px);
  }

  .view:is(:hover, :focus-visible) .arrow {
    transform: translate(3px, -3px);
  }

  .meta {
    margin-top: 26px;
    font-family: var(--font-space-mono);
    font-size: 13px;
    color: var(--muted);
  }

  @media (prefers-reduced-motion: reduce) {
    a,
    .arrow {
      transition: none;
    }

    a:active,
    .download:is(:hover, :focus-visible) .arrow,
    .view:is(:hover, :focus-visible) .arrow {
      transform: none;
    }
  }

  @media (max-width: 800px) {
    .download {
      width: 100%;
    }
  }
</style>
