---
import { Picture } from "astro:assets";
import ResumeActions from "@/components/ResumeActions.astro";
import heroPhoto from "@/assets/hero-photo.webp";
import { SITE } from "@/site";

const firstRole = SITE.roles[0].split(" ");
---

<section class="hero" aria-labelledby="hero-title">
  <div class="content">
    <p class="availability">
      <span class="dot" aria-hidden="true"></span>
      <span>{SITE.availability}</span>
    </p>

    <h1 id="hero-title">
      <span class="line">
        <span class="muted">Hi, I'm</span> {SITE.name}.
      </span>{" "}
      <span class="line">
        <span class="muted">I'm a</span>{" "}
        <span class="role" data-roles={JSON.stringify(SITE.roles)}>
          {firstRole.map((word, i) => (
            <Fragment>
              {i > 0 && " "}
              <span class="word">{word}</span>
            </Fragment>
          ))}
        </span>
        <span class="cursor" aria-hidden="true"></span>
      </span>
    </h1>

    <p class="summary">{SITE.summary}</p>

    <ResumeActions mail />
  </div>

  <!-- The backdrop: a transparent cut-out, black and white behind scan lines, drawn in from the top.
       On a phone it's a full-width band above the text. Likely the largest paint, so it loads first. -->
  <div class="photo">
    <Picture
      src={heroPhoto}
      formats={["avif"]}
      fallbackFormat="webp"
      alt="Azamat Jorayev in glasses and a black hoodie"
      loading="eager"
      fetchpriority="high"
    />
  </div>

  <div class="wave" aria-hidden="true">
    <img src="/hero.svg" alt="" width="3501" height="2149" decoding="async" />
  </div>

  <a class="cue only-desk" href="#projects">
    <span>
      <span aria-hidden="true">↓</span> <span class="verb">ls</span> projects
    </span>
  </a>

  <!-- Shown by the script below once the typing starts (WCAG 2.2.2: moving text needs a pause). -->
  <button class="typing-toggle" type="button" data-typing-toggle hidden>
    <svg class="icon-pause" viewBox="0 0 10 10" aria-hidden="true">
      <rect x="1.5" y="1" width="2.5" height="8" rx="0.5"></rect>
      <rect x="6" y="1" width="2.5" height="8" rx="0.5"></rect>
    </svg>
    <svg class="icon-play" viewBox="0 0 10 10" aria-hidden="true">
      <path d="M2.5 1.2v7.6a.5.5 0 0 0 .76.43l6.1-3.8a.5.5 0 0 0 0-.86L3.26.77a.5.5 0 0 0-.76.43z"></path>
    </svg>
    <span class="toggle-label">Pause animation</span>
  </button>
</section>

<script>
  const TYPE_SPEED = 90;
  const DELETE_SPEED = 50;
  const PAUSE_TIME = 400;
  // The first role is already on screen when the page loads, so give people time to read it.
  const FIRST_PAUSE = 2000;

  const role = document.querySelector<HTMLElement>("[data-roles]");
  const cursor = role?.parentElement?.querySelector<HTMLElement>(".cursor");
  const toggle = document.querySelector<HTMLButtonElement>(
    "[data-typing-toggle]",
  );
  const reducedMotion = window.matchMedia(
    "(prefers-reduced-motion: reduce)",
  ).matches;

  if (role && cursor && toggle && !reducedMotion) {
    const roles: string[] = JSON.parse(role.dataset.roles ?? "[]");
    const line = role.parentElement as HTMLElement;
    const label = toggle.querySelector(".toggle-label") as HTMLElement;

    // Screen readers read this static copy; the typing itself is visual only.
    const spoken = document.createElement("span");
    spoken.className = "sr-only";
    spoken.textContent = roles[0];
    role.before(spoken);
    role.setAttribute("aria-hidden", "true");
    line.closest("h1")?.classList.add("typing");

    // Non-breaking hyphens keep "full-stack" on one line while it types.
    const show = (text: string) => {
      role.textContent = text.replaceAll("-", "‑");
    };

    // Reserve the height of the tallest role, so the text below never jumps.
    const reserveHeight = () => {
      const current = role.textContent ?? "";
      line.style.minHeight = "";
      let tallest = 0;
      for (const text of roles) {
        show(text);
        tallest = Math.max(tallest, line.getBoundingClientRect().height);
      }
      role.textContent = current;
      line.style.minHeight = `${tallest}px`;
    };
    reserveHeight();
    document.fonts.ready.then(reserveHeight);
    let resizeFrame = 0;
    window.addEventListener("resize", () => {
      cancelAnimationFrame(resizeFrame);
      resizeFrame = requestAnimationFrame(reserveHeight);
    });

    let index = 0;
    let chars = roles[0].length;
    let deleting = true;
    let paused = false;
    let timer: number | undefined;

    const schedule = (delay: number) => {
      timer = window.setTimeout(step, delay);
    };

    const step = () => {
      const word = roles[index];
      cursor.classList.remove("blink");
      chars += deleting ? -1 : 1;
      show(word.slice(0, chars));

      if (!deleting && chars === word.length) {
        deleting = true;
        cursor.classList.add("blink");
        schedule(PAUSE_TIME);
        return;
      }

      if (deleting && chars === 0) {
        deleting = false;
        index = (index + 1) % roles.length;
      }

      schedule(deleting ? DELETE_SPEED : TYPE_SPEED);
    };

    toggle.addEventListener("click", () => {
      paused = !paused;
      toggle.classList.toggle("paused", paused);
      document.documentElement.dataset.motion = paused ? "paused" : "on";
      label.textContent = paused ? "Play animation" : "Pause animation";

      if (paused) {
        // Stop on a whole word rather than half of one.
        clearTimeout(timer);
        chars = roles[index].length;
        deleting = true;
        show(roles[index]);
        cursor.classList.remove("blink");
      } else {
        schedule(PAUSE_TIME);
      }
    });

    toggle.hidden = false;
    // The button pauses the logo cursor too (see Logo.astro).
    document.documentElement.dataset.motion = "on";
    cursor.classList.add("blink");
    schedule(FIRST_PAUSE);
  }
</script>

<style>
  .hero {
    position: relative;
    display: flex;
    align-items: center;
    width: 100%;
    min-height: 816px;
    padding: 48px var(--g) 96px;
    overflow: hidden;
  }

  .content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 24px;
    width: 100%;
    max-width: 660px;
  }

  @media (prefers-reduced-motion: no-preference) {
    .content {
      animation: rise 0.6s cubic-bezier(0.2, 0.8, 0.2, 1) 0.05s both;
    }
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
  }

  .availability {
    align-self: flex-start;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 7px 16px 7px 14px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--chip);
    font-size: 14px;
    letter-spacing: -0.01em;
    color: var(--fg2);
  }

  .dot {
    width: 8px;
    height: 8px;
    flex: none;
    border-radius: 50%;
    background: var(--mint);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--mint) 16%, transparent);
  }

  h1 {
    display: flex;
    flex-direction: column;
    gap: 0.18em;
    font-size: 58px;
    font-weight: 500;
    letter-spacing: -0.06em;
    line-height: 1.05;
  }

  .muted {
    color: var(--fg2);
  }

  .word {
    white-space: nowrap;
  }

  .cursor {
    display: none;
  }

  .typing .cursor {
    display: inline-block;
    width: 2px;
    height: 0.9em;
    margin-left: 0.08em;
    vertical-align: -0.12em;
    background: var(--fg);
  }

  .cursor.blink {
    animation: blink 1s steps(1) infinite;
  }

  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  .summary {
    max-width: 580px;
    font-size: 18px;
    line-height: 1.5;
    letter-spacing: -0.02em;
    color: var(--fg2);
  }

  /* The wave sits behind the text only and fades out before the photo. */
  .wave {
    position: absolute;
    top: 0;
    left: 0;
    width: 110%;
    height: 100%;
    filter: var(--wave-filter);
    mix-blend-mode: var(--wave-blend);
    opacity: var(--wave-opacity);
    pointer-events: none;
    mask-image: linear-gradient(to right, #000 0%, #000 30%, transparent 54%);
  }

  .wave img {
    width: 100%;
    height: 100%;
    max-width: none;
  }

  /* The photo fades in from the left; the image fades out at the bottom; scan lines run over it. */
  .photo {
    position: absolute;
    right: -3%;
    bottom: 0;
    height: 90%;
    pointer-events: none;
    mask-image: linear-gradient(to right, transparent 0%, #000 32%);
  }

  .photo::after {
    content: "";
    position: absolute;
    inset: 0;
    opacity: var(--scan);
    background: repeating-linear-gradient(
      to bottom,
      transparent 0 3px,
      var(--bg) 3px 5px
    );
  }

  .photo :global(picture) {
    height: 100%;
  }

  .photo :global(img) {
    width: auto;
    height: 100%;
    max-width: none;
    filter: var(--photo-filter);
    mask-image: linear-gradient(to top, transparent 0%, #000 22%);
  }

  /* Drawn in from top to bottom. */
  @media (prefers-reduced-motion: no-preference) {
    .photo :global(img) {
      animation: draw 1.6s cubic-bezier(0.4, 0, 0.2, 1) 0.2s both;
    }
  }

  @keyframes draw {
    from {
      clip-path: inset(0 0 100% 0);
    }

    to {
      clip-path: inset(0);
    }
  }

  .cue {
    position: absolute;
    left: 50%;
    bottom: 28px;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    height: 44px;
    padding: 0 12px;
    transform: translateX(-50%);
    font-family: var(--font-space-mono);
    font-size: 13px;
    color: var(--muted);
    white-space: nowrap;
    transition: color 0.16s ease;
  }

  .cue:hover {
    color: var(--fg);
  }

  .verb {
    color: var(--teal);
  }

  .typing-toggle {
    position: absolute;
    right: var(--g);
    bottom: 35px;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 12px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--chip);
    backdrop-filter: blur(10px);
    color: var(--fg2);
    font-family: var(--font-space-mono);
    font-size: 12px;
    cursor: pointer;
    transition:
      color 0.18s ease,
      border-color 0.18s ease;
  }

  .typing-toggle:hover {
    color: var(--fg);
    border-color: var(--fg2);
  }

  .typing-toggle svg {
    width: 10px;
    height: 10px;
    fill: currentColor;
  }

  .icon-play,
  .paused .icon-pause {
    display: none;
  }

  .paused .icon-play {
    display: block;
  }

  @media (prefers-reduced-motion: reduce) {
    .cue,
    .typing-toggle {
      transition: none;
    }
  }

  /* Below 1366px the photo shrinks with the window, so the face stays clear of the text column
     (the face starts at ~30% of the image's width; the text column needs the gutter + 600px). */
  @media (width > 1000px) {
    .photo {
      height: min(90%, (103vw - var(--g) - 600px) * 1.1);
    }
  }

  /* Tablets and phones: the photo becomes a full-width band above the text. */
  @media (max-width: 1000px) {
    .hero {
      flex-direction: column;
      align-items: stretch;
      min-height: 0;
      padding: 28px var(--g) 96px;
    }

    .photo {
      position: relative;
      right: auto;
      bottom: auto;
      order: -1;
      height: auto;
      margin: -28px calc(var(--g) * -1) 0;
      mask-image: none;
    }

    .photo :global(img) {
      width: 100%;
      height: 440px;
      object-fit: cover;
      object-position: 45% 0;
    }
  }

  @media (max-width: 800px) {
    .hero {
      padding-bottom: 64px;
    }

    .content {
      gap: 20px;
    }

    .photo :global(img) {
      height: 320px;
    }

    h1 {
      font-size: 34px;
    }

    .summary {
      font-size: 16px;
    }

    .typing-toggle {
      bottom: 20px;
    }
  }
</style>
