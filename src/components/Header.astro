---
import Logo from "@/components/Logo.astro";
import EmailButton from "@/components/EmailButton.astro";
import { SITE } from "@/site";
---

<header class="header">
  <Logo />
  <nav aria-label="Main">
    <a class="cmd only-desk" href="/#projects">
      <span>
        <span class="verb">ls</span> projects
      </span>
    </a>
    <a class="cmd only-desk" href={SITE.resume.url} download>
      <span>
        <span class="verb">cat</span> resume.pdf
      </span>
      <span class="sr-only">(download)</span>
    </a>
    <EmailButton class="only-desk" />
    <!-- The command palette's trigger: it un-hides it once the palette has loaded. -->
    <button
      class="palette"
      type="button"
      data-palette-open
      aria-haspopup="dialog"
      aria-expanded="false"
      aria-label="Open the command palette"
      hidden
    >
      <span class="prompt" aria-hidden="true">
        &gt;_
      </span>
      <kbd class="only-desk" aria-hidden="true">
        ⌘K
      </kbd>
    </button>
  </nav>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 30;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    height: var(--hdr-h);
    padding: 0 var(--g);
    border-bottom: 1px solid var(--line2);
    background: var(--hdr);
    backdrop-filter: blur(14px);
  }

  nav {
    display: flex;
    align-items: center;
    gap: 2px;
    margin-right: -8px;
    font-family: var(--font-space-mono);
    font-size: 15px;
  }

  .cmd {
    display: inline-flex;
    align-items: center;
    height: 44px;
    padding: 0 12px;
    border-radius: 8px;
    color: var(--fg2);
    white-space: nowrap;
    transition:
      color 0.16s ease,
      background 0.16s ease;
  }

  .cmd:hover {
    color: var(--fg);
    background: var(--sel);
  }

  .verb {
    color: var(--teal);
  }

  .palette {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    height: 40px;
    margin-left: 10px;
    padding: 0 10px 0 12px;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: var(--chip);
    color: var(--fg2);
    font-family: var(--font-space-mono);
    font-size: 13px;
    cursor: pointer;
    transition:
      border-color 0.16s ease,
      color 0.16s ease;
  }

  .palette:hover {
    border-color: var(--fg2);
    color: var(--fg);
  }

  .prompt {
    color: var(--mint);
  }

  kbd {
    display: inline-flex;
    align-items: center;
    height: 22px;
    padding: 0 6px;
    border: 1px solid var(--line);
    border-radius: 5px;
    font-size: 11px;
    color: var(--fg2);
  }

  @media (prefers-reduced-motion: reduce) {
    .cmd,
    .palette {
      transition: none;
    }
  }

  /* Tablets: the whole nav needs ~955px, so from 801 to 1000px the address and the ⌘K key cap go (tablets are
     mostly touch, and the logo keeps its room). `mail` still opens the mail app, the copy button still copies
     the address, and screen readers still hear it. */
  @media (width > 800px) and (max-width: 1000px) {
    nav :global(.address) {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }

    .palette {
      padding: 0 12px;
    }

    kbd {
      display: none;
    }
  }

  @media (max-width: 800px) {
    .palette {
      height: 44px;
      margin-left: 0;
      padding: 0 14px;
    }
  }
</style>
