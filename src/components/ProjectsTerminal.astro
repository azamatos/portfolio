  /* ── Motion ── */

  /* Pulses and the cursor: a few times by default, for good while the hero's typing runs, never once it's paused
     (the same rule as the logo's cursor, WCAG 2.2.2). */
  @media (prefers-reduced-motion: no-preference) {
    .cursor {
      animation: blink 1.1s steps(1) 4;
    }

    .pulse {
      animation: pulse 1.8s ease-out 3;
    }

    :global(html[data-motion="on"]) .cursor,
    :global(html[data-motion="on"]) .pulse {
      animation-iteration-count: infinite;
    }

    :global(html[data-motion="paused"]) .cursor,
    :global(html[data-motion="paused"]) .pulse {
      animation: none;
    }

    :global(html[data-motion="paused"]) .shot :global(img) {
      animation-play-state: paused;
    }

    /* The entrance (set up by the script): hidden below the fold, played once the list is on screen. */
    .term[data-play="wait"] .type {
      clip-path: inset(0 100% 0 0);
    }

    .term[data-play="wait"] .print,
    .term[data-play="wait"] .readme {
      opacity: 0;
    }

    .term[data-play="in"] .ls-cmd {
      animation: type 0.48s steps(var(--n), end) 0.2s both;
    }

    .term[data-play="in"] .print {
      animation: print 0.26s cubic-bezier(0.2, 0.8, 0.2, 1)
        calc(0.72s + var(--i) * 0.08s) both;
    }

    /* A panel's animations restart each time it's shown: the README of every pick types and fades in again. */
    .term[data-play="in"] .panel:not([hidden]) .cat-cmd {
      animation: type 0.44s steps(var(--n), end) 1.3s both;
    }

    .term[data-play="in"] .panel:not([hidden]) .readme {
      animation: reveal 0.4s cubic-bezier(0.2, 0.8, 0.2, 1) 1.75s both;
    }

    .term[data-picked] .panel:not([hidden]) .cat-cmd {
      animation-delay: 0s;
    }

    .term[data-picked] .panel:not([hidden]) .readme {
      animation-duration: 0.36s;
      animation-delay: 0.4s;
    }

    .item[open] .content {
      animation: drop 0.34s cubic-bezier(0.2, 0.8, 0.2, 1) both;
    }

    /* The accordion opens and closes: the content box grows to its height and back, and stays rendered while it
       shrinks. Elsewhere the script animates it. */
    @supports (interpolate-size: allow-keywords) {
