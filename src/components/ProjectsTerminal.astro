---
// The home page's Projects section (#projects): `ls -la projects` in a terminal that stays dark in both themes.
//
// Desktop: the list, then each project's README. The script turns the rows into WAI-ARIA tabs and shows one README
// at a time; without JavaScript the rows are links to the READMEs, which all stack under the list.
// Phone (≤ 800px): an accordion of <details name="projects">, one open at a time, no JavaScript needed. Opening one
// expands it and collapses the one that was open (0.28 s): in CSS where the browser can size to `auto`
// (interpolate-size), with the Web Animations API elsewhere. An opened item whose row ends up off screen scrolls back.
//
// Motion, never with reduced motion: when the list scrolls into view the command types in, the rows print one by
// one, then `cat <dir>README.md` types and the README fades up; every later pick types and fades again. The HTML is
// always the final state (screen readers and no-JavaScript visitors get it at once): typing only clips the text.
// The cursor blinks, amber dots pulse, Visaproof's full-page screenshot pans, and Rebuffer's and pass's READMEs are
// loops (Media.astro: only the selected one loads and plays, and only on screen); the hero's pause button
// (html[data-motion="paused"]) stops them all, like the logo's cursor.
//
// Coming back from a project page by its `cd ..` link (AllProjects.astro leaves the id in sessionStorage) selects that
// project's row, or opens its item on a phone.

import Media from "@/components/project/Media.astro";
import { getProjects, projectsIntro } from "@/lib/projects";

const projects = await getProjects();
const intro = await projectsIntro();

/** A README loop loads the refresh's README rendition (README_WIDTH in scripts/refresh/shots/encode.ts). */
const README_WIDTH = 960;

/**
 * How wide the README screenshot shows. The terminal's body is the window less the gutters (120px, 80px up to
 * 1200px) and 66px of border and padding; from 1087px the screenshot shares it with the text (1.15 : 1, 40px gap).
 */
const DESK_SIZES =
  "(min-width: 1201px) calc((100vw - 346px) * 0.535), (min-width: 1087px) calc((100vw - 266px) * 0.535), calc(100vw - 226px)";
/** Phone: the window less 12px of section padding, the terminal's and the README's padding and the borders. */
const PHONE_SIZES = "calc(100vw - 60px)";

const rows = projects.map((p) => ({
  p,
  live: p.status === "live",
  /** The list's word: "live" or "building". */
  word: p.status === "live" ? "live" : "building",
  cat: `cat ${p.list.dir}README.md`,
  /** The arrow's colour: the project's dark accent, since the terminal is always dark. */
  style: `--tc: ${p.accent.dark}`,
}));

const LS = "ls -la projects";
---

<section id="projects" class="projects" aria-labelledby="projects-title">
  <div class="intro">
    <div class="titles">
      <h2 id="projects-title">{intro.title}</h2>
      <p class="subtitle">{intro.subtitle}</p>
    </div>
    <p class="hint only-desk">{intro.hint}</p>
  </div>

  <div class="term desk theme-dark only-desk" data-term>
    <div class="bar" aria-hidden="true">
      <span>azamatos@web: ~/projects</span>
      <span>zsh · 120×40</span>
    </div>

    <div class="body">
      <p class="prompt">
        <span class="arrow" aria-hidden="true">
          ➜
        </span>
        <span class="cwd" aria-hidden="true">
          ~
        </span>
        <span class="type ls-cmd" style={`--n: ${LS.length}`}>
          {LS}
        </span>
      </p>

      <div class="ls">
        <div class="cols print" aria-hidden="true" style="--i: 0">
          <span class="c-mode">mode</span>
          <span>status</span>
          <span>commits</span>
          <span class="c-stack">stack</span>
          <span>name</span>
        </div>
        <ul class="rows" aria-label="Projects" data-rows>
          {rows.map(({ p, live, word, style }, i) => (
            <li class="print" style={`--i: ${i + 1}; ${style}`}>
              <a
                class="row"
                href={`#readme-${p.id}`}
                id={`tab-${p.id}`}
                data-tab
              >
                {/* The name comes first, so the row's name reads "rebuffer/ live 140 commits …" (WCAG 2.5.3: it
                    holds all of the visible text); the grid areas put each cell in its column. */}
                <span class="name">
                  <span class="arrow" aria-hidden="true">
                    ➜
                  </span>
                  <span class="dir" id={`tab-${p.id}-name`}>
                    {p.list.dir}
                  </span>
                  <span class="cursor" aria-hidden="true">
                    ▊
                  </span>
                </span>
                <span class:list={["status", { live }]}>
                  <span
                    class:list={["dot", { pulse: !live }]}
                    aria-hidden="true"
                  />
                  {word}
                </span>
                <span class="commits-n">
                  {p.list.commits} <span class="sr-only">commits</span>
                </span>
                <span class="c-stack stack">{p.list.stack}</span>
                <span class="c-mode mode" aria-hidden="true">
                  {p.list.mode}
                </span>
              </a>
            </li>
          ))}
        </ul>
      </div>

      {rows.map(({ p, live, cat }) => (
        <div class="panel" id={`readme-${p.id}`} data-panel>
          <p class="prompt">
            <span class="arrow" aria-hidden="true">
              ➜
            </span>
            <span class="cwd" aria-hidden="true">
              ~/projects
            </span>
            <span class="type cat-cmd" style={`--n: ${cat.length}`}>
              {cat}
            </span>
          </p>
          <article class="readme" aria-labelledby={`readme-${p.id}-title`}>
            <div class="shot">
              <Media
                media={p.readme.image}
                alt={p.readme.alt}
                sizes={DESK_SIZES}
                frame="readme"
                host={p.readme.host}
                ratio="16 / 10"
                position="50% 0%"
                pan={p.readme.panImage}
                videoWidth={README_WIDTH}
              />
            </div>
            <div class="text">
              <p class="kind">
                # {p.readme.kind} ·{" "}
                <span class:list={["status", { live }]}>
                  <span
                    class:list={["dot", { pulse: !live }]}
                    aria-hidden="true"
                  />
                  {p.statusText}
                </span>
              </p>
              <h3 id={`readme-${p.id}-title`}>{p.readme.headline}</h3>
              <p class="desc">{p.readme.description}</p>
              {p.readme.progress && (
                <ol class="steps" aria-label="Progress">
                  {p.readme.progress.steps.map((step, i) => {
                    const at = p.readme.progress!.current;
                    const state = i < at ? "done" : i === at ? "now" : "next";
                    return (
                      <li
                        class={state}
                        aria-current={state === "now" ? "step" : undefined}
                      >
                        <span
                          class:list={["mark", { pulse: state === "now" }]}
                          aria-hidden="true"
                        >
                          {state === "done" ? "✓" : state === "next" ? "○" : ""}
                        </span>
                        {step}
                        {state === "done" && (
                          <span class="sr-only"> (done)</span>
                        )}
                      </li>
                    );
                  })}
                </ol>
              )}
              <ul class="tech" aria-label="built with">
                <li class="tech-label" aria-hidden="true">
                  built with
                </li>
                {p.readme.tech.map((t) => (
                  <li class="chip">{t}</li>
                ))}
              </ul>
              <dl class="stats">
                {p.readme.stats.map((s) => (
                  <div>
                    <dt>{s.label}</dt>
                    <dd>{s.value}</dd>
                  </div>
                ))}
              </dl>
              <div class="links">
                <a class="btn primary" href={p.path}>
                  Read the case study <span class="sr-only">of {p.name}</span>
                  <svg
                    viewBox="0 0 24 24"
                    width="16"
                    height="16"
                    aria-hidden="true"
                  >
                    <path d="M5 12h14" />
                    <path d="M13 6l6 6-6 6" />
                  </svg>
                </a>
                <a
                  class="btn"
                  href={p.readme.secondaryLink.href}
                  target="_blank"
                  rel="noopener"
                >
                  {p.readme.secondaryLink.label}
                  <span class="sr-only"> (opens in a new tab)</span>
                  <svg
                    viewBox="0 0 24 24"
                    width="16"
                    height="16"
                    aria-hidden="true"
                  >
                    <path d="M7 17L17 7" />
                    <path d="M8 7h9v9" />
                  </svg>
                </a>
              </div>
            </div>
          </article>
        </div>
      ))}
    </div>
  </div>

  <div class="term phone theme-dark only-phone">
    <div class="bar" aria-hidden="true">
      <span>~/projects</span>
      <span>zsh</span>
    </div>

    <div class="body">
      <p class="prompt">
        <span class="arrow" aria-hidden="true">
          ➜
        </span>
        <span class="cwd" aria-hidden="true">
          ~
        </span>
        ls -l projects
      </p>

      <div class="items">
        {rows.map(({ p, live, word, style }, i) => (
          <details
            class="item"
            name="projects"
            open={i === 0}
            style={style}
            data-item={p.id}
          >
            <summary>
              <span class="head">
                <span class="name">
                  <span class="arrow" aria-hidden="true">
                    ➜
                  </span>
                  {p.list.dir}
                </span>{" "}
                <span class="meta">
                  <span class:list={["status", { live }]}>
                    <span
                      class:list={["dot", { pulse: !live }]}
                      aria-hidden="true"
                    />
                    {word}
                  </span>{" "}
                  <span class="commits">· {p.list.commits} commits</span>
                </span>
              </span>
              <span class="chevron" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="14" height="14">
                  <path d="M6 9l6 6 6-6" />
                </svg>
              </span>
            </summary>
            <div class="content">
              <p class="cat">$ cat {p.list.dir}README.md</p>
              <Media
                media={p.readme.phoneImage}
                alt={p.readme.alt}
                sizes={PHONE_SIZES}
                frame="phone"
                host={p.readme.host}
                ratio="16 / 10"
                videoWidth={README_WIDTH}
              />
              <h3>{p.readme.headline}</h3>
              <p class="short">{p.readme.short}</p>
              <ul class="tech" aria-label="built with">
                {p.readme.tech.map((t) => (
                  <li class="chip">{t}</li>
                ))}
              </ul>
              <dl class="stats">
                {p.readme.stats.map((s) => (
                  <div>
                    <dt>{s.short}</dt>
                    <dd>{s.value}</dd>
                  </div>
                ))}
              </dl>
              <a class="cta" href={p.path}>
                Read the case study <span class="sr-only">of {p.name}</span>
              </a>
            </div>
          </details>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  // The desktop terminal's rows become tabs (the WAI-ARIA tabs pattern) once this runs; until then, and without
  // JavaScript, they're links and every README shows.
  //
  // Selection follows focus (automatic activation): every README is already in the page, so it shows at once, and
  // the highlighted row and the open README never disagree. Arrows (both axes), Home and End move and select;
  // a click, Enter or Space selects. Tab leaves the list for the open README.

  const STEP: Record<string, number> = {
    ArrowDown: 1,
    ArrowRight: 1,
    ArrowUp: -1,
    ArrowLeft: -1,
  };

  const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;

  /**
   * The project page the visitor came back from by its `cd ..` link (AllProjects.astro leaves its id), once: a later
   * reload shows the first project again.
   */
  const cameBackFrom = () => {
    try {
      const id = sessionStorage.getItem("projects:back");
      sessionStorage.removeItem("projects:back");
      return id;
    } catch {
      return null;
    }
  };
  const back = cameBackFrom();
  /** Each terminal's way to show a project: the desktop selects its row, the phone opens its item. */
  const showers: ((id: string) => void)[] = [];
  const showProject = (id: string | null) => {
    if (id) for (const show of showers) show(id);
  };

  // Phone: the <details> work without this. It opens the project the visitor came back from, animates the
  // accordion where CSS can't, and brings an opened item's row back on screen.
  const items = [
    ...document.querySelectorAll<HTMLDetailsElement>("details[data-item]"),
  ];
  showers.push((id) => {
    const item = items.find((d) => d.dataset.item === id);
    if (item) for (const d of items) d.open = d === item;
  });
  showProject(back);

  const DURATION = 280;
  const EASE = "cubic-bezier(0.2, 0.8, 0.2, 1)";
  /** Chromium: the CSS below animates ::details-content to and from `auto`; nothing to do here. */
  const cssAnimates = CSS.supports("interpolate-size", "allow-keywords");
  /** The accordion's animations under way, each with what it does when it ends. */
  const running: { anim: Animation; end: () => void }[] = [];
  /**
   * Height from → to on the <details> itself, its overflow clipped meanwhile. While animations run, the items lose
   * their shared `name`, so the browser doesn't close the old one at once; it gets it back when they end.
   */
  const animateHeight = (
    d: HTMLDetailsElement,
    from: number,
    to: number,
    done?: () => void,
  ) => {
    d.style.overflow = "hidden";
    const a = d.animate(
      { height: [`${from}px`, `${to}px`] },
      { duration: DURATION, easing: EASE },
    );
    const run = {
      anim: a,
      end: () => {
        if (!running.includes(run)) return;
        running.splice(running.indexOf(run), 1);
        d.style.overflow = "";
        done?.();
        if (!running.length)
          for (const item of items) item.setAttribute("name", "projects");
      },
    };
    running.push(run);
    a.addEventListener("finish", run.end);
    a.addEventListener("cancel", run.end);
  };
  const collapse = (d: HTMLDetailsElement) => {
    const summary = d.querySelector("summary")!;
    const border = d.offsetHeight - d.clientHeight;
    const fade = d
      .querySelector(".content")
      ?.animate(
        { opacity: [1, 0] },
        { duration: DURATION * 0.6, easing: "ease-out", fill: "forwards" },
      );
    animateHeight(d, d.offsetHeight, summary.offsetHeight + border, () => {
      d.open = false;
      fade?.cancel();
    });
  };

  /** The item whose row the visitor just clicked: once it's open, its row comes back on screen if it left. */
  let clicked: HTMLDetailsElement | null = null;
  for (const item of items) {
    item.querySelector("summary")?.addEventListener("click", (e) => {
      clicked = item;
      if (reduce || cssAnimates) return;
      e.preventDefault();
      // A click during an animation ends it first (its `finish` event would only come later).
      for (const r of [...running]) {
        r.anim.finish();
        r.end();
      }
      if (item.open) {
        collapse(item);
        return;
      }
      const others = items.filter((d) => d !== item && d.open);
      for (const d of items) d.removeAttribute("name");
      const from = item.offsetHeight;
      item.open = true;
      animateHeight(item, from, item.offsetHeight);
      for (const d of others) collapse(d);
    });
    item.addEventListener("toggle", () => {
      if (clicked !== item) return;
      clicked = null;
      if (!item.open) return;
      // Once the old item has collapsed above it, the row may sit under the sticky header or off the top. Its place
      // is read when the animations are over: at least their length, then two frames in which the row didn't move.
      const summary = item.querySelector("summary")!;
      const start = performance.now();
      let last = NaN;
      let still = 0;
      const settle = () => {
        const r = summary.getBoundingClientRect();
        still = r.top === last ? still + 1 : 0;
        last = r.top;
        const waited = performance.now() - start;
        const settled = (reduce || waited >= DURATION) && still >= 2;
        if (!settled && waited < 1500)
          return void requestAnimationFrame(settle);
        const top =
          parseFloat(
            getComputedStyle(document.documentElement).scrollPaddingTop,
          ) || 0;
        if (r.top < top || r.bottom > innerHeight)
          summary.scrollIntoView({
            behavior: reduce ? "auto" : "smooth",
            block: "start",
          });
      };
      requestAnimationFrame(settle);
    });
  }

  for (const term of document.querySelectorAll<HTMLElement>("[data-term]")) {
    const list = term.querySelector<HTMLElement>("[data-rows]");
    const tabs = [...term.querySelectorAll<HTMLAnchorElement>("[data-tab]")];
    const panels = tabs.map((t) =>
      document.getElementById(t.getAttribute("href")?.slice(1) ?? ""),
    );
    if (!list || !tabs.length || panels.some((p) => !p)) continue;

    list.setAttribute("role", "tablist");
    list.setAttribute("aria-orientation", "vertical");
    for (const li of list.children) li.setAttribute("role", "none");
    tabs.forEach((tab, i) => {
      const panel = panels[i]!;
      tab.setAttribute("role", "tab");
      tab.setAttribute("aria-controls", panel.id);
      panel.setAttribute("role", "tabpanel");
      // Named by the tab's name ("visaproof/"), not the whole row.
      panel.setAttribute(
        "aria-labelledby",
        tab.querySelector(".dir")?.id ?? tab.id,
      );
      panel.tabIndex = 0;
    });

    let current = -1;
    const select = (i: number, focus = false) => {
      if (i !== current) {
        // After the first pick, the README types and fades in at once, not after the rows.
        if (current >= 0) term.dataset.picked = "";
        tabs.forEach((tab, j) => {
          const on = j === i;
          tab.setAttribute("aria-selected", String(on));
          tab.tabIndex = on ? 0 : -1;
          panels[j]!.hidden = !on;
        });
        current = i;
      }
      if (focus) tabs[i].focus();
    };
    const indexOf = (id: string | null) =>
      tabs.findIndex((t) => t.id === `tab-${id}`);
    select(Math.max(0, indexOf(back)));
    showers.push((id) => {
      if (indexOf(id) >= 0) select(indexOf(id));
    });

    list.addEventListener("click", (e) => {
      const tab = (e.target as Element).closest<HTMLAnchorElement>(
        "[data-tab]",
      );
      if (!tab) return;
      e.preventDefault();
      select(tabs.indexOf(tab));
    });

    list.addEventListener("keydown", (e) => {
      if (e.altKey || e.ctrlKey || e.metaKey) return;
      const i = tabs.indexOf(document.activeElement as HTMLAnchorElement);
      if (i < 0) return;
      let next: number;
      if (e.key in STEP) next = (i + STEP[e.key] + tabs.length) % tabs.length;
      else if (e.key === "Home") next = 0;
      else if (e.key === "End") next = tabs.length - 1;
      else if (e.key === " ")
        next = i; // Enter clicks the link; Space doesn't
      else return;
      e.preventDefault();
      select(next, true);
    });

    // The entrance plays once, when most of the list is on screen. A visitor already past the list's top (a reload
    // lower down, with the scroll restored before or after this runs) gets the README at once, as after a pick. The
    // terminal is watched too: a jump past the list crosses none of the list's own thresholds.
    if (!reduce && "IntersectionObserver" in window) {
      term.dataset.play = "wait";
      const io = new IntersectionObserver(
        () => {
          const r = list.getBoundingClientRect();
          if (r.top < 0) term.dataset.picked = "";
          else if (Math.min(r.bottom, innerHeight) - r.top < r.height / 2)
            return;
          io.disconnect();
          term.dataset.play = "in";
        },
        { threshold: [0, 0.5] },
      );
      io.observe(list);
      io.observe(term);
    }
  }
</script>

<style>
  .projects {
    padding: 112px var(--g) 120px;
    border-top: 1px solid var(--line2);
  }

  .intro {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 12px 24px;
    margin-bottom: 36px;
  }

  .titles {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  h2 {
    font-size: 48px;
    font-weight: 500;
    letter-spacing: -0.045em;
    line-height: 1.1;
  }

  .subtitle {
    font-size: 18px;
    letter-spacing: -0.02em;
    color: var(--fg2);
  }

  .hint {
    font-family: var(--font-space-mono);
    font-size: 13px;
    color: var(--muted);
  }

  /* ── The terminal frame: dark in both themes (.theme-dark pins the tokens) ── */

  .term {
    --frame-border: rgba(255, 255, 255, 0.14);

    display: flex;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 16px;
    background: #060606;
    color: var(--fg);
    box-shadow: 0 40px 100px rgba(0, 0, 0, 0.35);
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    height: 44px;
    padding: 0 20px;
    border-bottom: 1px solid var(--line2);
    font-family: var(--font-space-mono);
    font-size: 12px;
    color: var(--muted);
    white-space: nowrap;
  }

  .body {
    display: flex;
    flex-direction: column;
    gap: 20px;
    padding: 28px 32px 36px;
    font-family: var(--font-space-mono);
  }

  .prompt {
    display: flex;
    align-items: center;
    gap: 0.6em;
    font-size: 16px;
    line-height: 1.5;
    color: #f0f4f3;
  }

  .prompt .arrow {
    color: var(--mint);
  }

  .cwd {
    color: var(--teal);
  }

  .type {
    display: inline-block;
    white-space: nowrap;
  }

  /* ── The list ── */

  .ls {
    display: flex;
    flex-direction: column;
  }

  .rows {
    padding: 0;
  }

  .cols,
  .row {
    display: grid;
    grid-template-columns: 120px 150px 90px minmax(0, 1fr) minmax(0, 1.3fr);
    align-items: center;
    gap: 16px;
  }

  .cols {
    padding: 0 16px 10px;
    font-size: 12px;
    line-height: 1.5;
    color: var(--muted);
  }

  .row {
    grid-template-areas: "mode status commits stack name";
    min-height: 56px;
    padding: 8px 16px;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 8px;
    color: var(--fg2);
    font-size: 13px;
    line-height: 1.5;
    transition:
      background-color 0.16s ease,
      color 0.16s ease;
  }

  .row:hover {
    background: rgba(255, 255, 255, 0.035);
  }

  .row[aria-selected="true"] {
    background: rgba(255, 255, 255, 0.06);
  }

  .row:focus-visible {
    outline-offset: 0;
  }

  .mode {
    grid-area: mode;
    color: var(--muted);
  }

  .row .status {
    grid-area: status;
  }

  .commits-n {
    grid-area: commits;
  }

  .stack {
    grid-area: stack;
  }

  .row .name {
    grid-area: name;
  }

  .status {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--amber);
  }

  .status.live {
    color: var(--mint);
  }

  .dot {
    flex: none;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: currentColor;
  }

  .stack,
  .dir {
