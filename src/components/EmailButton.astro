---
import { SITE } from "@/site";

interface Props {
  /** "header": a command in the header nav; "line": the underlined line under the hero buttons on a phone. */
  variant?: "header" | "line";
  class?: string;
}

const { variant = "header", class: className } = Astro.props;
---

<div class:list={["email", variant, className]}>
  <a class="send" href={`mailto:${SITE.email}`}>
    <span>
      <span class="verb">mail</span> <span class="address">{SITE.email}</span>
    </span>
  </a>
  <!-- Shown by the script below only where the Clipboard API exists. -->
  <button
    class="copy"
    type="button"
    data-copy={SITE.email}
    aria-label="Copy email address"
    title="Copy email address"
    hidden
  >
    <svg class="icon-copy" viewBox="0 0 24 24" aria-hidden="true">
      <rect x="9" y="9" width="11" height="11" rx="2"></rect>
      <path d="M5 15V6a2 2 0 0 1 2-2h9"></path>
    </svg>
    <svg class="icon-done" viewBox="0 0 24 24" aria-hidden="true">
      <path d="M5 12.5l4.5 4.5L19 7.5"></path>
    </svg>
    <span class="copied-label" aria-hidden="true">
      copied
    </span>
  </button>
  <span class="sr-only" role="status"></span>
</div>

<script>
  for (const button of document.querySelectorAll<HTMLButtonElement>(
    "button[data-copy]",
  )) {
    const status = button.parentElement?.querySelector('[role="status"]');
    let timer: number | undefined;

    if (navigator.clipboard) {
      button.hidden = false;
    }

    button.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(button.dataset.copy ?? "");
      } catch {
        if (status) status.textContent = "Couldn't copy the email address";
        return;
      }

      button.classList.add("copied");
      if (status) status.textContent = "Email address copied";

      clearTimeout(timer);
      timer = window.setTimeout(() => {
        button.classList.remove("copied");
        if (status) status.textContent = "";
      }, 1600);
    });
  }
</script>

<style>
  .email {
    display: inline-flex;
    align-items: center;
    font-family: var(--font-space-mono);
  }

  .send {
    display: inline-flex;
    align-items: center;
    height: 44px;
    color: var(--fg);
    white-space: nowrap;
  }

  .verb {
    color: var(--teal);
  }

  .copy {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    height: 44px;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--fg2);
    cursor: pointer;
  }

  svg {
    width: 16px;
    height: 16px;
    flex: none;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.75;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .icon-done {
    display: none;
    stroke-width: 2;
  }

  .copied {
    color: var(--mint);
  }

  .copied .icon-copy {
    display: none;
  }

  .copied .icon-done {
    display: block;
  }

  .copied-label {
    position: absolute;
    top: 46px;
    right: 0;
    display: none;
    padding: 3px 8px;
    border: 1px solid var(--line);
    border-radius: 6px;
    background: var(--bg);
    font-size: 11px;
    line-height: 1.5;
    color: var(--mint);
    white-space: nowrap;
  }

  .copied .copied-label {
    display: block;
  }

  /* Header: two commands sharing one hover style with ls and cat. */
  .header .send {
    padding: 0 4px 0 12px;
    border-radius: 8px;
  }

  .header .copy {
    width: 40px;
    border-radius: 8px;
  }

  .header .send,
  .header .copy {
    transition:
      color 0.16s ease,
      background 0.16s ease;
  }

  .header .send:hover,
  .header .copy:hover {
    background: var(--sel);
  }

  .header .copy:hover {
    color: var(--fg);
  }

  .header .copied:hover {
    color: var(--mint);
  }

  /* Line: centred under the hero buttons on a phone. */
  .line {
    justify-content: center;
    gap: 4px;
    width: 100%;
    font-size: 14px;
  }

  .line .send {
    text-decoration: underline;
    text-decoration-color: var(--line);
    text-underline-offset: 5px;
  }

  .line .copy {
    width: 44px;
  }

  .line .copied-label {
    top: 40px;
    right: 50%;
    transform: translateX(50%);
  }

  @media (prefers-reduced-motion: no-preference) {
    .copied .icon-done,
    .copied .copied-label {
      animation: pop 0.24s cubic-bezier(0.2, 0.8, 0.2, 1) both;
    }
  }

  @keyframes pop {
    from {
      opacity: 0;
      translate: 0 3px;
    }
  }
</style>
