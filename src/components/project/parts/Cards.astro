---
// A grid of cards: an optional mono tag in the accent, a title and a body. As many per row as fit at `min` wide, in
// rows as even as that allows, and never one card alone on the last row (as the big numbers go two by two): six cards
// go three and three where five would fit, and three go one per row where only two would.
//
// The grid's own width picks the columns, without media queries: `--track`, a column's least width, is the share of
// the chosen number of columns, from one `clamp` per number of columns that switches at the width where that many
// cards fit at `min` (`(fit × min + gaps − 100%) × 1000` is negative from there on, and huge below it).

import type { PartOf } from "../types";

interface Props {
  part: PartOf<"cards">;
}

const { part } = Astro.props;
const n = part.items.length;

/** The columns when `fit` cards fit in a row: as few rows as that allows, as even as they can be, none alone. */
function columns(fit: number) {
  let c = Math.ceil(n / Math.ceil(n / fit));
  while (c > 1 && n % c === 1) c--;
  return c;
}

/** Each number of columns above one, with the fewest cards per row at which it's used; the most columns first. */
const steps: { columns: number; fit: number }[] = [];
for (let fit = n; fit > 1; fit--) {
  const c = columns(fit);
  const last = steps.at(-1);
  if (c === 1) break;
  if (last?.columns === c) last.fit = fit;
  else steps.push({ columns: c, fit });
}
const track = steps.reduceRight(
  (fewer, { columns: c, fit }) =>
    `clamp((100% - ${c - 1} * var(--gap)) / ${c} - 0.01px, (${fit} * var(--min) + ${fit - 1} * var(--gap) - 100%) * 1000, ${fewer})`,
  "100%",
);
---

<ul class="cards" style={`--min: ${part.min}; --track: ${track}`}>
  {part.items.map((item) => (
    <li>
      {item.tag && <span class="tag">{item.tag}</span>}
      <h3>{item.title}</h3>
      <p>{item.body}</p>
    </li>
  ))}
</ul>

<style>
  .cards {
    --gap: 12px;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(var(--track), 1fr));
    gap: var(--gap);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 20px;
    border: 1px solid var(--line2);
    border-radius: 12px;
    background: var(--chip);
  }

  .tag {
    font-family: var(--font-space-mono), monospace;
    font-size: 11px;
    line-height: 1.5;
    color: var(--acc);
  }

  h3 {
    margin: 0;
    font-size: 16px;
    font-weight: 500;
    line-height: 1.5;
    letter-spacing: -0.01em;
  }

  p {
    margin: 0;
    font-size: 14px;
    line-height: 1.55;
    color: var(--fg2);
  }
</style>
