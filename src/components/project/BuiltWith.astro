---
// "Built with", numbered after the last section: a row per group, its name in the accent (above the pills on a
// phone), the pills (name and version) and a one-line note.

import Section from "./Section.astro";
import type { BuiltWithGroup } from "./types";

interface Props {
  /** "06": the section number after the page's last section. */
  number: string;
  groups: BuiltWithGroup[];
}

const { number, groups } = Astro.props;
---

<Section number={number} title="built with" layout="flush">
  {groups.map((g) => (
    <div class="row">
      <h3>{g.group}</h3>
      <div class="items">
        <ul>
          {g.items.map((t) => (
            <li>
              {t.name} {t.version && <span class="version">{t.version}</span>}
            </li>
          ))}
        </ul>
        <p>{g.note}</p>
      </div>
    </div>
  ))}
</Section>

<style>
  .row {
    display: grid;
    grid-template-columns: 150px minmax(0, 1fr);
    gap: 12px 24px;
    padding: 18px 0;
    border-bottom: 1px solid var(--line2);
  }

  h3 {
    margin: 0;
    font-family: var(--font-space-mono), monospace;
    font-size: 13px;
    font-weight: 400;
    line-height: 1.5;
    color: var(--acc);
  }

  .items {
    display: flex;
    flex-direction: column;
    gap: 10px;
    min-width: 0;
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li {
    padding: 5px 12px;
    border: 1px solid var(--line);
    border-radius: 999px;
    font-size: 14px;
    line-height: 1.5;
    color: var(--fg);
  }

  .version {
    margin-left: 2px;
    font-family: var(--font-space-mono), monospace;
    font-size: 11px;
    color: var(--muted);
  }

  p {
    margin: 0;
    font-size: 14px;
    line-height: 1.55;
    color: var(--fg2);
  }

  @media (max-width: 800px) {
    .row {
      grid-template-columns: minmax(0, 1fr);
      gap: 10px;
    }
  }
</style>
